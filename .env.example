# Kopieren nach .env.local und ausfüllen (wird nicht committet)

# Supabase (Gästebuch): Projekt-URL und Publishable Key (Settings → API Keys)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Nur lokal für `npm run wallpapers:sync` (Upload in den Storage-Bucket "wallpapers").
# Secret Key (Settings → API Keys → Secret keys) – NIE mit VITE_-Präfix, landet sonst im Browser!
SUPABASE_SECRET_KEY=

# Optional: YouTube Data API v3 Key für bessere Song-Zuordnung beim playlist:sync
YOUTUBE_API_KEY=
